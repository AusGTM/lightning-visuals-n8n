__pycache__/
.env
*.pyc
.n8n_credential_ids.json
operator-claude-plugin/config/operator.local.json
operator-claude-plugin/scratch/
# The plugin's only persisted state: one dashboard Artifact identifier + its timestamp
# (D-09b). Named as the file rather than the directory on purpose — a second state file
# should show up in `git status` and get argued about, not be swallowed by a wildcard.
operator-claude-plugin/state/dashboard_artifact.json

# GSD dispatch-isolation sentinel (session-local)
.gsd/

# Phase 63 Plan 03 — raw judge-replay corpus (real company identity + research
# evidence pulled from stored n8n executions). Never committed; the verdict
# artifact (input_id + sha256 only) is what ships.
.judge-replay-corpus/

# Quick task 260904-39r (G-62-5) — scripts/role_vocabulary.py's derived output. A run
# artifact, not a deliverable: it is never merged into or auto-adopted over the shipped,
# live-proven operator-claude-plugin/config/role_vocabulary.yaml (D-4).
operator-claude-plugin/config/role_vocabulary.derived.yaml

# GSD writes this per-run cursor (next command, updated_at, a phase mirror of STATE.md).
# Generated, churns on every command, and has never been committed in this repo — ignoring it
# so it stops reading as an untracked change on every `git status`.
.planning/state.json

# operator UAT spreadsheets carry real names and emails — never commit
uat-batch-*.csv

# UAT stress assets: the contacts CSV carries real CRM people (rows 1-2); snapshots/reports carry record ids
tests/stress-tests/uat-stress-mixed-batch-*.csv
tests/stress-tests/uat-reset-snapshot*.json
tests/stress-tests/uat-reset-report-*.json

# demo-run reset artefacts (record ids)
tests/demo-run/uat-reset-snapshot*.json
tests/demo-run/uat-reset-report-*.json

# raw plugin-session transcript (1MB+, may embed tool output)
tests/stress-tests/session.log
tests/stress-tests/session-*.log
# demo-run: any file holding a real, enrichable person (see DEMO-RUNBOOK.md "Landing a contact")
tests/demo-run/*-real*.csv
