# HubSpot
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxxxxxxxxxxxx
HUBSPOT_PORTAL_ID=00000000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_HAIKU_MODEL=claude-3-5-haiku-latest
ANTHROPIC_SONNET_MODEL=claude-sonnet-5-latest


# Providers
# ZoomInfo uses OAuth2 client-credentials (not a single key): client_id + client_secret
# → POST gtm/oauth/v1/token → short-lived Bearer. (In n8n these go in a Basic Auth
# credential, NOT here — this .env is the Python MVP only; providers are mocked.)
ZOOMINFO_CLIENT_ID=
ZOOMINFO_CLIENT_SECRET=
# Apollo & Lusha use a single static API key (sent as a header).
APOLLO_API_KEY=
LUSHA_API_KEY=

# Runtime
DRY_RUN=true
USE_MOCK_PROVIDERS=true
USE_MOCK_WEB_RESEARCH=true
ALLOW_WEB_RESEARCH=false
ALLOW_SONNET_ESCALATION=false
ALLOW_CANONICAL_WRITES=false
ALLOW_ICP_SCORE_WRITES=true
ALLOW_STAGING_WRITES=true
ALLOW_CONTACT_CREATE=false
LOG_LEVEL=INFO
LOCK_TTL_MINUTES=15
DEFAULT_ENRICHMENT_MODE=icp_score

# Safety
ALLOW_TEST_RECORD_WRITES=true
TEST_CONTACT_IDS=123,456
TEST_COMPANY_IDS=789
MAX_WEB_RESEARCH_PER_RUN=10
MAX_SONNET_VALIDATIONS_PER_RUN=10
MAX_PROVIDER_CREDITS_PER_RUN=50
