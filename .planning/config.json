{
  "workflow": {
    "_auto_chain_active": true,
    "use_worktrees": false,
    "plan_review_convergence": true,
    "nyquist_validation": true,
    "security_enforcement": true,
    "test_command": ".venv/bin/python -m pytest -q --tb=short && node --test tests/n8n/*.test.mjs"
  },
  "review": {
    "reviewer_instances": {
      "gpt-5-6-sol": {
        "cli": "opencode",
        "model": "openrouter/openai/gpt-5.6-sol"
      },
      "kimi-k3": {
        "cli": "opencode",
        "model": "openrouter/moonshotai/kimi-k3"
      },
      "grok-4-6": {
        "cli": "opencode",
        "model": "openrouter/x-ai/grok-4.6"
      }
    },
    "default_reviewers": [
      "gpt-5-6-sol",
      "kimi-k3",
      "grok-4-6"
    ]
  }
}
