{
  "id": "LVweeklySweep001",
  "name": "LV Weekly Dedupe Sweep (local replica)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1 }]
        }
      },
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 220]
    },
    {
      "parameters": {},
      "id": "c1000000-0000-4000-8000-000000000004",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [260, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1000000-0000-4000-8000-000000000001",
              "name": "records",
              "value": "={{ [ { \"id\": \"c1\", \"properties\": { \"email\": \"dup@example.com\", \"phone\": \"0400 111 222\" } }, { \"id\": \"c2\", \"properties\": { \"email\": \"DUP@example.com\", \"phone\": \"0400 333 444\" } }, { \"id\": \"c3\", \"properties\": { \"email\": \"solo@example.com\", \"phone\": \"not a phone\" } } ] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Set Sweep Records",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8088/sweep",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"records\": {{ JSON.stringify($json.records) }} }",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "POST /sweep",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Weekly Schedule": {
      "main": [[{ "node": "Set Sweep Records", "type": "main", "index": 0 }]]
    },
    "Manual Trigger": {
      "main": [[{ "node": "Set Sweep Records", "type": "main", "index": 0 }]]
    },
    "Set Sweep Records": {
      "main": [[{ "node": "POST /sweep", "type": "main", "index": 0 }]]
    }
  },
  "settings": {}
}
